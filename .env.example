APP_NAME=Translation & Transcription
APP_VERSION=0.1.0
ENVIRONMENT=development
DEBUG=false

HOST=0.0.0.0
PORT=8000

LOG_LEVEL=INFO

# Maximum uploaded audio size in megabytes.
MAX_FILE_SIZE_MB=5

# Maximum decoded audio duration.
MAX_AUDIO_DURATION_SECONDS=30


# Maximum number of characters accepted by /translate.
MAX_TRANSLATION_CHARS=250


# Maximum number of simultaneous model inference operations.
# Keep this low on CPU-only machines. Each ASR inference can consume
# substantial RAM/CPU.
MAX_INFLIGHT=1

# Maximum time spent waiting for an inference slot.
INFERENCE_ACQUIRE_TIMEOUT_SECONDS=5

# Maximum time allowed for one model inference operation.
INFERENCE_TIMEOUT_SECONDS=120



TRANSLATION_PROVIDER=opus_mt

# Keep this configurable so the concrete provider can decide which model
# corresponds to the requested language pair.
TRANSLATION_MODEL=


ASR_PROVIDER=faster_whisper

# "tiny" is the low-memory/fast option.
#
# You can change this to:
# tiny
# base
# small
#
# tiny is the recommended default for this take-home.
ASR_MODEL=tiny

ASR_DEVICE=cpu
ASR_COMPUTE_TYPE=int8


DETECTION_PROVIDER=lingua


MODEL_CACHE_DIR=.cache/models